{% extends '@DemosPlanCore/DemosPlanCore/base.html.twig' %}

{% block component_part %}
    {% include '@DemosPlanCore/DemosPlanProcedure/includes/administration_list_pageheader.html.twig' with {
        heading: 'search.submitter.cross_procedures'|trans,
        highlighted: 'procedure_search_submitters'
    } %}

    <p class="font-size-small u-mb-0_75">
        {{ "search.submitter.cross_procedures.hint"|trans }}
    </p>

    <dp-search-submitters :searchable-procedures="JSON.parse('{{ templateVars.procedures|json_encode|e('js', 'utf-8') }}')"></dp-search-submitters>

{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {{ webpackBundle('procedure-administrationSearchSubmitters.js') }}
{% endblock javascripts %}
