{% extends '@DemosPlanCore/DemosPlanCore/base.html.twig' %}

{% block component_part %}
    {% include '@DemosPlanCore/DemosPlanProcedure/includes/administration_list_pageheader.html.twig' with {
        heading: 'search.submitter'|trans,
        highlighted: 'procedure_search_submitters'
    } %}

    <p class="font-size-small mb-4">
        {{ "search.submitter.cross.procedures.hint"|trans }}
    </p>

    {% set submitTypesOptions = [] %}
    {% for key, translated in getFormOption('statement_submit_types.values', true)|filter(key => key != 'system') %}
        {% set submitTypesOptions = submitTypesOptions|merge([{ label: translated, value: key }]) %}
    {% endfor %}

    <dp-search-submitters
        :submit-type-options="JSON.parse('{{ submitTypesOptions|json_encode|e('js', 'utf-8') }}')">
    </dp-search-submitters>

{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {{ webpackBundle('procedure-administrationSearchSubmitters.js') }}
{% endblock javascripts %}
