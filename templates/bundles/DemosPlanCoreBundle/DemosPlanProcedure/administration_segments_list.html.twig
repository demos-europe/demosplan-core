{% extends '@DemosPlanCore/DemosPlanCore/procedure.html.twig' %}
{% set procedure = procedureId %}

{% block component_part %}
    {% embed '@DemosPlanCore/DemosPlanCore/includes/base_pageheader.html.twig' with {
        heading: 'segments'|trans,
        flush: true
    } %}
        {% block pageheader_actions %}
            {% if hasPermission('feature_procedure_user_filter_sets') %}
                <segments-bookmarks-button
                    ref="bookmarksButton"
                    @click="$refs.segmentsList.openBookmarks()">
                </segments-bookmarks-button>
            {% endif %}
        {% endblock %}
    {% endembed %}

    {# Version history, send-via-mail and filter panels, driven by the SegmentSlidebar store. Each panel toggles its own visibility. #}
    <segment-slidebar>
        <dp-version-history procedure-id="{{ procedure }}"></dp-version-history>
        <dp-segment-recommendation-email
            current-user-email="{{ currentUser.email }}"
            procedure-name="{{ procedureObject.name }}"
        ></dp-segment-recommendation-email>
        <segments-list-filter
            ref="segmentsListFilter"
            :filters="JSON.parse('{{ filterNames|json_encode|e('js', 'utf-8') }}')"
            :initial-filter="JSON.parse('{{ segmentListQuery.filter|json_encode|e('js', 'utf-8') }}')"
            @filter-apply="$refs.segmentsList.sendFilterQuery($event)"
            @filter-options:request="$refs.segmentsList.sendFilterOptionsRequest($event)"
        ></segments-list-filter>
        {# Custom side panel content #}

        {% if hasPermission('feature_procedure_user_filter_sets') %}
            <segments-bookmarks
                procedure-id="{{ procedure }}"
                :total-column-count="$refs.segmentsList?.selectableColumns?.length || 0"
                :current-search-phrase="$refs.segmentsList?.searchTerm || ''"
                :current-sorting="$refs.segmentsList?.selectedSort || ''"
                :current-selected-columns="$refs.segmentsList?.currentSelection || []"
                :default-selected-columns="$refs.segmentsList?.defaultColumnSelection || []"
                :filters="JSON.parse('{{ filterNames|json_encode|e('js', 'utf-8') }}')"
                @apply-bookmark="$refs.segmentsList.applyBookmarkSettings($event); $refs.segmentsListFilter.syncFromBookmark($event.attributes.filter)"
                @reset-view="$refs.segmentsList.applyBookmarkSettings(null)"
                @update-button-text="$refs.bookmarksButton.updateButtonText($event)">
            </segments-bookmarks>
        {% endif %}
    </segment-slidebar>

    <segments-list
        ref="segmentsList"
        procedure-id="{{ procedure }}"
        current-user-id="{{ currentUser.ident }}"
        :filter-names="JSON.parse('{{ filterNames|json_encode|e('js', 'utf-8') }}')"
        :initial-filter="JSON.parse('{{ segmentListQuery.filter|json_encode|e('js', 'utf-8') }}')"
        initial-search-term="{{ segmentListQuery.searchPhrase|default }}"
        {# Empty when the hash carries no view settings, in which case it arrives as [] rather than {} #}
        :initial-view-settings="JSON.parse('{{ segmentListQuery.viewSettings|json_encode|e('js', 'utf-8') }}')"
        @reset-filters="$refs.segmentsListFilter.resetAllFilters(); $refs.bookmarksButton.updateButtonText('{{ 'views'|trans }}')">
    </segments-list>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {{ webpackBundle('procedure-administrationSegmentsList.js')}}
{% endblock javascripts %}
